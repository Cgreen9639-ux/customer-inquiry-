-- File 2: Product Management with Inventory Validation

SELECT 
  product_id,
  name,
  category,
  unit_price,
  stock_level
FROM products;

CREATE TRIGGER validate_product_insert
BEFORE INSERT ON products
FOR EACH ROW
BEGIN
  IF NEW.stock_level < 0 THEN
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'Stock level cannot be negative';
  END IF;
  
  IF NEW.unit_price <= 0 THEN
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'Price must be greater than zero';
  END IF;
END;
