-- File 4: Customer Lifetime Value Analysis

WITH customer_metrics AS (
  SELECT 
    customer_id,
    COUNT(order_id) AS purchase_frequency,
    AVG(order_amount) AS avg_order_size,
    SUM(order_amount) AS lifetime_value
  FROM orders
  GROUP BY customer_id
)
SELECT 
  customer_id,
  purchase_frequency,
  avg_order_size,
  lifetime_value,
  ROUND(purchase_frequency * avg_order_size, 2) AS calculated_ltv
FROM customer_metrics
WHERE lifetime_value > 0
ORDER BY lifetime_value DESC;
